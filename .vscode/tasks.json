{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MTG: Update from GitHub + Deploy",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\update-and-deploy.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "MTG: Update via UPDATE_TABLE.bat",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "\"${workspaceFolder}\\UPDATE_TABLE.bat\" --no-pause"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
