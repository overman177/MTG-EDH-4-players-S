<!-- PATCH NOTES -->
<Panel id="PatchNotesPanel" width="620" height="520" rectAlignment="MiddleCenter" showAnimation="FadeIn" hideAnimation="FadeOut" returnToOriginalPositionWhenReleased="false" allowDragging="true" color="rgba(0.1,0.1,0.1,0.97)" outline="#635351" outlineSize="2 -2" visibility="" active="False">
    <Text id="PatchNotesTitle" rectAlignment="UpperCenter" offsetXY="0 -22" width="520" height="36" fontSize="28" fontStyle="Bold" color="rgb(1,1,1)" alignment="MiddleCenter" text="Patch Notes" />
    <Button id="PatchNotesCloseButton" rectAlignment="UpperRight" offsetXY="-10 -10" width="34" height="34" color="#990000" textColor="#FFFFFF" text="X" fontSize="20" onClick="closePatchNotes" />
    <VerticalScrollView rectAlignment="LowerCenter" offsetXY="0 14" width="596" height="448" horizontal="false" horizontalScrollbarVisibility="None" scrollSensitivity="30" color="rgba(0,0,0,0.35)">
        <TableLayout autoCalculateHeight="true" cellSpacing="0" padding="4 8 4 4" columnWidths="560" cellBackgroundColor="rgba(0,0,0,0)">
            <Row id="PatchNotesRow" preferredHeight="1100"><Cell>
                <Text id="PatchNotesText" fontSize="17" color="rgb(0.9,0.9,0.9)" alignment="UpperLeft" text="Loading..." />
            </Cell></Row>
        </TableLayout>
    </VerticalScrollView>
</Panel>


<!-- Brief, non-interactive version label shown on table load. -->
<Panel id="MTG_VersionBanner" rectAlignment="UpperCenter" offsetXY="0 -28"
    width="410" height="58" color="rgba(0.08,0.09,0.12,0.92)"
    outline="#506B8A" outlineSize="1 -1"
    showAnimation="FadeIn" hideAnimation="FadeOut"
    active="false" raycastTarget="false">
    <Text id="MTG_VersionBannerText" rectAlignment="MiddleCenter"
        width="388" height="44" fontSize="21" fontStyle="Bold"
        alignment="MiddleCenter" color="#E6EEF8" raycastTarget="false"
        text="" />
</Panel>
