<!-- REVEAL UNTIL TYPE -->
<!-- Deck context-menu picker: reveal cards until one of the chosen types is hit.
     Styled to match the Settings / Bug-report panels: outlined dark panel, bold
     title, red X close (STcancel), blue section headers, green action button. -->
<Panel id="SearchTypePanel" width="384" height="452" rectAlignment="MiddleCenter" showAnimation="FadeIn" hideAnimation="FadeOut" returnToOriginalPositionWhenReleased="false" allowDragging="true" color="rgba(0.1,0.1,0.1,0.97)" outline="#635351" outlineSize="2 -2" visibility="" active="False">
    <Text id="STtext" rectAlignment="UpperCenter" offsetXY="0 -18" width="340" height="32" fontSize="24" fontStyle="Bold" color="rgb(1,1,1)" alignment="MiddleCenter" text="Reveal Until Type" />
    <Button rectAlignment="UpperRight" offsetXY="-8 -8" width="30" height="30" color="#990000" textColor="#FFFFFF" text="X" fontSize="18" onClick="STcancel" />

    <VerticalLayout rectAlignment="UpperCenter" offsetXY="0 -56" width="344" height="380" spacing="8" childForceExpandHeight="false" childForceExpandWidth="true">
        <Text preferredHeight="20" minHeight="20" fontSize="14" fontStyle="Bold" color="#6fa0d8" alignment="MiddleLeft" text="CARD TYPES" />
        <GridLayout preferredHeight="148" minHeight="148" cellSize="164 32" spacing="8 6" constraint="FixedColumnCount" constraintCount="2" startCorner="UpperLeft" startAxis="Horizontal" childAlignment="MiddleCenter">
            <ToggleButton id="land" text="Land" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="creature" text="Creature" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="artifact" text="Artifact" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="enchantment" text="Enchantment" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="planeswalker" text="Planeswalker" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="battle" text="Battle" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="instant" text="Instant" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
            <ToggleButton id="sorcery" text="Sorcery" onValueChanged="UItypeToggle" isOn="false" fontSize="17" textColor="rgb(1,1,1)" alignment="MiddleCenter" colors="rgb(0.18,0.18,0.18)|rgb(0.26,0.26,0.26)|rgb(0.26,0.26,0.26)|rgb(0.18,0.18,0.18)" selectedBackgroundColor="#31506f" deselectedBackgroundColor="rgb(0.18,0.18,0.18)" />
        </GridLayout>

        <Text preferredHeight="20" minHeight="20" fontSize="14" fontStyle="Bold" color="#6fa0d8" alignment="MiddleLeft" text="CUSTOM TYPE" />
        <InputField id="typeCustom" preferredHeight="32" minHeight="32" onEndEdit="UItypeCustom" placeholder="e.g. Dragon, Equipment…" text="" fontSize="16" textAlignment="MiddleLeft" characterValidation="Alphanumeric" color="rgb(0.18,0.18,0.18)" textColor="rgb(1,1,1)" caretColor="rgb(1,1,1)" />

        <HorizontalLayout preferredHeight="34" minHeight="34" spacing="8" childAlignment="MiddleLeft" childForceExpandWidth="false" childForceExpandHeight="false">
            <Text fontSize="16" color="rgb(0.9,0.9,0.9)" alignment="MiddleLeft" preferredWidth="70" minWidth="70" text="Repeat" />
            <InputField id="repeatX" onEndEdit="UIrepeatSearchType" characterValidation="Integer" placeholder="1" text="" fontSize="16" textAlignment="MiddleCenter" preferredWidth="56" minWidth="56" preferredHeight="34" minHeight="34" color="rgb(0.18,0.18,0.18)" textColor="rgb(1,1,1)" caretColor="rgb(1,1,1)" tooltip="how many times to repeat the reveal" tooltipPosition="Above" tooltipBorderColor="rgba(0,0,0,0)" />
            <Text fontSize="16" color="rgb(0.6,0.6,0.6)" alignment="MiddleLeft" flexibleWidth="1" text="time(s)" />
        </HorizontalLayout>

        <Button onClick="STokay" preferredHeight="44" minHeight="44" text="Reveal" fontSize="18" fontStyle="Bold" color="#2a6f2a" textColor="#FFFFFF" />
    </VerticalLayout>
</Panel>

