<!-- PATCH NOTES -->
<Panel id="PatchNotesPanel" width="620" height="520" rectAlignment="MiddleCenter" showAnimation="FadeIn" hideAnimation="FadeOut" returnToOriginalPositionWhenReleased="false" allowDragging="true" color="rgba(0.1,0.1,0.1,0.97)" outline="#635351" outlineSize="2 -2" visibility="" active="False">
    <Text id="PatchNotesTitle" rectAlignment="UpperCenter" offsetXY="0 -22" width="520" height="36" fontSize="28" fontStyle="Bold" color="rgb(1,1,1)" alignment="MiddleCenter" text="Patch Notes" />
    <Button id="PatchNotesCloseButton" rectAlignment="UpperRight" offsetXY="-10 -10" width="34" height="34" color="#990000" textColor="#FFFFFF" text="X" fontSize="20" onClick="closePatchNotes" />
    <VerticalScrollView rectAlignment="LowerCenter" offsetXY="0 14" width="596" height="448" horizontal="false" horizontalScrollbarVisibility="None" scrollSensitivity="30" color="rgba(0,0,0,0.35)">
        <TableLayout autoCalculateHeight="true" cellSpacing="0" padding="4 8 4 4" columnWidths="560" cellBackgroundColor="rgba(0,0,0,0)">
            <Row id="PatchNotesRow" preferredHeight="1100"><Cell>
                <Text id="PatchNotesText" fontSize="17" color="rgb(0.9,0.9,0.9)" alignment="UpperLeft" text="Loading..." />
            </Cell></Row>
        </TableLayout>
    </VerticalScrollView>
</Panel>


<!-- Animated, non-interactive Black Lotus startup signature. -->
<Panel id="MTG_VersionBanner" rectAlignment="UpperCenter" offsetXY="0 -22"
    width="466" height="83" color="rgba(0.055,0.065,0.09,0.95)"
    outline="#AB9062" outlineSize="2 -2"
    showAnimation="SlideIn_Top" hideAnimation="FadeOut"
    animationDuration="0.55" active="false" raycastTarget="false">
    <Panel rectAlignment="MiddleLeft" offsetXY="7 0" width="4" height="54"
        color="#C3A46F" raycastTarget="false" />
    <Panel rectAlignment="MiddleRight" offsetXY="-7 0" width="4" height="54"
        color="#C3A46F" raycastTarget="false" />
    <Text rectAlignment="UpperCenter" offsetXY="0 -8"
        width="430" height="21" fontSize="16" fontStyle="Bold"
        alignment="MiddleCenter" color="#D4B47B" raycastTarget="false"
        text="BLACK LOTUS   /   COMMANDER" />
    <Text id="MTG_VersionBannerText" rectAlignment="MiddleCenter" offsetXY="0 -1"
        width="430" height="30" fontSize="23" fontStyle="Bold"
        alignment="MiddleCenter" color="#F5F0E9" raycastTarget="false" text="" />
    <Text id="MTG_VersionBannerSubtitle" rectAlignment="LowerCenter" offsetXY="0 7"
        width="430" height="20" fontSize="13" fontStyle="Bold"
        alignment="MiddleCenter" color="#A9C4C0" raycastTarget="false"
        text="READY TO PLAY" active="false" showAnimation="FadeIn" animationDuration="0.6" />
</Panel>
