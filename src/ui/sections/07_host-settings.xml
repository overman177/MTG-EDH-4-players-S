<!-- Host settings and enforcement controls. Lua handles host authorization. -->
<!-- Host settings -->
<!-- The gold gear opens host settings, next to the player settings gear. -->
<Button id="hostGear" onClick="openHostSettings" text="&#9881;" textAlignment="MiddleCenter" padding="0 0 0 0"
    rectAlignment="LowerRight" offsetXY="-125 6" width="46" height="46" fontSize="28"
    color="rgba(0.1,0.1,0.1,0.85)" textColor="#e0a030"
    tooltip="Host settings (host only)" tooltipPosition="Left" tooltipBorderColor="rgba(0,0,0,0)" />

<!-- The enforcement switches and value switches use separate callbacks. -->
<Panel id="HostSettingsPanel" width="440" height="560" rectAlignment="MiddleCenter" showAnimation="FadeIn" hideAnimation="FadeOut" returnToOriginalPositionWhenReleased="false" allowDragging="true" color="rgba(0.32,0.20,0.03,0.98)" outline="#e0a030" outlineSize="2 -2" visibility="" active="False">
    <Text rectAlignment="UpperCenter" offsetXY="0 -20" width="360" height="34" fontSize="26" fontStyle="Bold" color="#ffd873" alignment="MiddleCenter" text="Host Settings" />
    <Button rectAlignment="UpperRight" offsetXY="-8 -8" width="30" height="30" color="#990000" textColor="#FFFFFF" text="X" fontSize="18" onClick="closeHostSettings" />
    <InputField id="hostSearchInput" rectAlignment="UpperCenter" offsetXY="0 -62" width="404" height="34" onValueChanged="hostSettingsSearch" placeholder="Search settings..." text="" fontSize="16" textAlignment="MiddleLeft" color="rgba(0.5,0.34,0.06,0.9)" textColor="rgb(1,1,1)" caretColor="rgb(1,1,1)" />

    <VerticalScrollView rectAlignment="LowerCenter" offsetXY="0 12" width="416" height="438" horizontal="false" horizontalScrollbarVisibility="None" scrollSensitivity="26" color="rgba(0,0,0,0.12)" scrollbarBackgroundColor="rgba(0,0,0,0.18)">
        <TableLayout autoCalculateHeight="true" cellSpacing="4" padding="12 8 12 4" columnWidths="372" cellBackgroundColor="rgba(0,0,0,0)">
            <Row id="hosthdr_legend" preferredHeight="24"><Cell><HorizontalLayout spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
                <Text fontSize="12" fontStyle="Bold" color="#ffd873" alignment="MiddleLeft" flexibleWidth="1" text="ENF forces the value on all players" />
                <Text fontSize="12" fontStyle="Bold" color="#ffd873" alignment="MiddleCenter" minWidth="46" preferredWidth="46" flexibleWidth="0" text="ENF" />
                <Text fontSize="12" fontStyle="Bold" color="#ffd873" alignment="MiddleCenter" minWidth="46" preferredWidth="46" flexibleWidth="0" text="ON" />
            </HorizontalLayout></Cell></Row>

            <Row id="hosthdr_triggers" preferredHeight="24"><Cell><Text fontSize="14" fontStyle="Bold" color="#f4c261" alignment="MiddleLeft" text="TRIGGERS" /></Cell></Row>
            <Row id="hostrow_oppDrawTriggers" preferredHeight="32"><Cell><HorizontalLayout spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
                <Text fontSize="15" color="rgb(0.95,0.92,0.85)" alignment="MiddleLeft" flexibleWidth="1" text="Opponent-draw trigger alerts" />
                <Toggle id="hostEnf_oppDrawTriggers" isOn="False" onValueChanged="hostToggleEnforced" minWidth="46" preferredWidth="46" flexibleWidth="0" />
                <Toggle id="hostVal_oppDrawTriggers" isOn="False" interactable="false" onValueChanged="hostToggleValue" minWidth="46" preferredWidth="46" flexibleWidth="0" />
            </HorizontalLayout></Cell></Row>

            <Row id="hosthdr_stateBased" preferredHeight="24"><Cell><Text fontSize="14" fontStyle="Bold" color="#f4c261" alignment="MiddleLeft" text="STATE-BASED" /></Cell></Row>
            <Row id="hostrow_drawSkipReminder" preferredHeight="32"><Cell><HorizontalLayout spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
                <Text fontSize="15" color="rgb(0.95,0.92,0.85)" alignment="MiddleLeft" flexibleWidth="1" text="Draw-step skip reminder" />
                <Toggle id="hostEnf_drawSkipReminder" isOn="False" onValueChanged="hostToggleEnforced" minWidth="46" preferredWidth="46" flexibleWidth="0" />
                <Toggle id="hostVal_drawSkipReminder" isOn="False" interactable="false" onValueChanged="hostToggleValue" minWidth="46" preferredWidth="46" flexibleWidth="0" />
            </HorizontalLayout></Cell></Row>
            <Row id="hostrow_abilityRestrictions" preferredHeight="32"><Cell><HorizontalLayout spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
