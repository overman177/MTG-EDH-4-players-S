                <Toggle id="hostVal_abilityRestrictions" isOn="False" interactable="false" onValueChanged="hostToggleValue" minWidth="46" preferredWidth="46" flexibleWidth="0" />
            </HorizontalLayout></Cell></Row>
            <Row id="hostrow_searchRestrictions" preferredHeight="32"><Cell><HorizontalLayout spacing="8" childForceExpandWidth="false" childAlignment="MiddleLeft">
